# Server-side URL of FastAPI (inside Docker: http://api:8000)
API_INTERNAL_URL=http://localhost:8000
# Public site URL: canonical links, sitemap, OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallback language for "/" when neither cookie nor Accept-Language match.
# Development: uk (served under /ua). Production: es. Crawlers always get /es.
NEXT_PUBLIC_DEFAULT_LOCALE=uk
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/DalnoboySpainCE_bot