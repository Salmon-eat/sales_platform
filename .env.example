# Used by docker-compose.yml (dev) and docker-compose.prod.yml (prod/staging).
# Copy to .env and adjust.

# Public domain served by Caddy (prod/staging only)
DOMAIN=bazarcito.example.com
# Language for "/" when neither cookie nor Accept-Language match: es in production
DEFAULT_LOCALE=es
TELEGRAM_BOT_URL=https://t.me/DalnoboySpainCE_bot
POSTGRES_USER=bazarcito
POSTGRES_PASSWORD=bazarcito
POSTGRES_DB=bazarcito

# openssl rand -hex 32
SECRET_KEY=change-me

# Admin sign-in (admin spec §1): OAuth client of type "Web application" in Google Cloud Console,
# with the site origin (and http://localhost:3000 for development) in "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Development only: sign in to /admin by a whitelisted email without Google. The API refuses to start
# with it in production.
ADMIN_DEV_LOGIN=true

# Telegram bot sync: the same random secret goes into SITE_API_TOKEN in the bot's .env
# (openssl rand -hex 32). Empty = the bot cannot reach the site.
BOT_SYNC_TOKEN=

# Cloudflare Turnstile (free anti-bot check on the forms): dash.cloudflare.com -> Turnstile -> Add site,
# widget mode "Managed". Both empty = off (the honeypot and per-IP limits still protect the forms).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
