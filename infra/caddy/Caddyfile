{
	servers {
		# slow-request attacks (Slowloris and the like) hold connections open: cut them off
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		# Behind Cloudflare, uncomment so the real visitor IP (not Cloudflare's) reaches the rate limits:
		# trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		# client_ip_headers CF-Connecting-IP
	}
}

(site) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# A huge body is an attack on memory: 1 MB everywhere, except a CV attached to an application (5 MB + slack).
	@cv path_regexp ^/v1/applications/cv/[A-Za-z0-9_-]+$
	@not_cv not path_regexp ^/v1/applications/cv/[A-Za-z0-9_-]+$
	request_body @cv {
		max_size 6MB
	}
	request_body @not_cv {
		max_size 1MB
	}

	# Scanners probe for secrets and other platforms' admin pages: answer at once, never pass them on.
	@probes {
		path /.env* /.git* /.svn* /.hg* /.DS_Store *.php /wp-* /wp/* /xmlrpc* /phpmyadmin* /server-status* /cgi-bin/* /.aws/* /.ssh/* *.sql *.bak /config.json /actuator*
	}
	respond @probes 404 {
		close
	}

	handle /v1/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

{$DOMAIN} {
	import site
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Temporary: the client can click the site by IP while the domain's DNS is moving. Plain HTTP, no HSTS.
http://{$SERVER_IP} {
	import site
	header X-Robots-Tag "noindex, nofollow"
}
