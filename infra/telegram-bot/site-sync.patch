+                                             0, "text", payload["text"], "failed",
+                                             sender_name=payload.get("sender_name") or None)
+        await self.repo.db.execute("UPDATE messages SET site_message_id = ?, error = ? WHERE id = ?",
+                                   (payload["site_message_id"], raw[:500], log_id))
+
     async def _client_unreachable(self, client: dict, app: dict, payload: dict, error: Exception,
