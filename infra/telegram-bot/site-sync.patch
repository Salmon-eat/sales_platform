+    async def _site_reply(self, client_id: int, payload: dict) -> None:
+        """A manager answered in the website admin: the client gets it here, the team sees it in the topic."""
+        app = await self.repo.get_application(payload["app_id"])
+        client = await self.repo.get_client(client_id)
