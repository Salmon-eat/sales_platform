diff --git a/bot/site_sync.py b/bot/site_sync.py
new file mode 100644
index 0000000..2b7103e
--- /dev/null
+++ b/bot/site_sync.py
@@ -0,0 +1,191 @@
+"""Mirror of applications and conversations on the website admin, and replies written there.
+
+Off unless SITE_API_URL and SITE_API_TOKEN are set. The bot itself works exactly as without it: this task only
+reads the database, sends new rows to the site and puts replies from the site into the outbox, where they go
+to the client like any other manager message. The bot opens no port: it always calls the site, never the other
+way round. Cursors live in the settings table, so after a restart or a site outage nothing is lost or repeated.
+"""
+
+import asyncio
+import html
+import logging
+import re
+from typing import Any
+
+import aiohttp
+
+from . import render
+from .db import loads, now_iso
+from .repo import Repo
+
+log = logging.getLogger(__name__)
+
+POLL_SECONDS = 5
+BATCH = 100
+TIMEOUT = aiohttp.ClientTimeout(total=20)
+
+APPS_CURSOR = "site_sync_apps"  # "updated_at|id" of the last application sent
+MESSAGES_CURSOR = "site_sync_messages"  # id of the last message sent
+OUTGOING_CURSOR = "site_sync_outgoing"  # id of the last reply or status taken from the site
+
+# Statuses the site can set; "rejected" has no match in the bot, so it closes the application.
+FROM_SITE = {"new": "new", "in_progress": "in_work", "done": "done", "rejected": "done"}
+
+
+def plain(text: str) -> str:
+    """Telegram HTML (b, i, a) as plain text for the site."""
+    return html.unescape(re.sub(r"<[^>]+>", "", text))
+
+
+class SiteSync:
+    def __init__(self, repo: Repo, url: str, token: str, tz: str):
+        self.repo = repo
+        self.url = url.rstrip("/")
+        self.headers = {"Authorization": f"Bearer {token}"}
+        self.tz = tz
+        self._failing = False
+
+    async def run(self) -> None:
+        async with aiohttp.ClientSession(timeout=TIMEOUT, headers=self.headers) as http:
+            while True:
+                try:
+                    busy = await self.cycle(http)
+                    if self._failing:
+                        log.info("Site sync is working again")
+                        self._failing = False
+                except asyncio.CancelledError:
+                    raise
+                except Exception as error:
+                    busy = False
+                    if not self._failing:  # one line per outage, not one every few seconds
+                        log.warning("Site sync failed, will retry: %r", error)
+                        self._failing = True
+                if not busy:
+                    await asyncio.sleep(POLL_SECONDS)
+
+    async def cycle(self, http: aiohttp.ClientSession) -> bool:
+        """One round; True while there is more to send right away."""
+        pushed = await self.push(http)
+        pulled = await self.pull(http)
+        return pushed or pulled
+
+    # --- bot -> site ----------------------------------------------------
+
+    async def push(self, http: aiohttp.ClientSession) -> bool:
+        apps, apps_cursor = await self._changed_applications()
+        messages = await self._new_messages()
+        if not apps and not messages:
+            return False
+        clients = {a["client_id"] for a in apps} | {m["client_id"] for m in messages}
+        body = {
+            "applications": apps,
+            "messages": [self._message(m) for m in messages],
+            "topics": await self._topics(clients),
+        }
+        async with http.post(f"{self.url}/v1/internal/bot/sync", json=body) as response:
+            response.raise_for_status()
+        # Only after the site has stored everything: a failed request is simply sent again.
+        if apps:
+            await self.repo.set_setting(APPS_CURSOR, apps_cursor)
+        if messages:
+            await self.repo.set_setting(MESSAGES_CURSOR, str(messages[-1]["id"]))
+        return len(apps) == BATCH or len(messages) == BATCH
+
+    async def _changed_applications(self) -> tuple[list[dict[str, Any]], str]:
+        stamp, _, last_id = (await self.repo.get_setting(APPS_CURSOR) or "|0").partition("|")
+        # Times have whole seconds: the current second is left for the next round, otherwise a change made
+        # later within it would carry the cursor's own time and never be sent.
+        rows = await self.repo.db.fetchall(
+            "SELECT a.*, c.username, c.telegram_user_id, c.lang AS client_lang FROM applications a "
+            "JOIN clients c ON c.id = a.client_id "
+            "WHERE (a.updated_at > ? OR (a.updated_at = ? AND a.id > ?)) AND a.updated_at < ? "
+            "ORDER BY a.updated_at, a.id LIMIT ?",
+            (stamp, stamp, int(last_id or 0), now_iso(), BATCH),
+        )
+        lang = self.repo.group_lang
+        apps = []
+        for row in rows:
+            row["answers"] = loads(row["answers"]) or {}
+            client = {"id": row["client_id"], "username": row["username"], "lang": row["client_lang"],
+                      "telegram_user_id": row["telegram_user_id"]}
+            apps.append({
+                "id": row["id"],
+                "client_id": row["client_id"],
+                "title": plain(render.app_title(lang, row)),
+                "card": plain(render.card_text(row, client, self.tz, lang, hint=False)),
+                "name": row["name"],
+                "phone": row["phone"] or None,
+                "username": row["username"],
+                "lang": row["lang"],
+                "status": row["status"],
+                "manager_name": row["manager_name"],
+                "created_at": row["created_at"],
+                "updated_at": row["updated_at"],
+            })
+        cursor = f"{rows[-1]['updated_at']}|{rows[-1]['id']}" if rows else ""
+        return apps, cursor
+
+    async def _new_messages(self) -> list[dict[str, Any]]:
+        last = int(await self.repo.get_setting(MESSAGES_CURSOR) or 0)
+        return await self.repo.db.fetchall(
+            "SELECT m.*, (SELECT MAX(a.id) FROM applications a WHERE a.client_id = m.client_id) AS latest_app "
+            "FROM messages m WHERE m.id > ? ORDER BY m.id LIMIT ?",
+            (last, BATCH),
+        )
+
+    @staticmethod
+    def _message(row: dict[str, Any]) -> dict[str, Any]:
+        return {
+            "id": row["id"],
+            "client_id": row["client_id"],
+            # a message written between applications belongs to the client's latest one
+            "app_id": row["application_id"] or row["latest_app"],
+            "direction": row["direction"],
+            "sender_name": row["sender_name"],
+            "content_type": row["content_type"],
+            "text": row["text"],
+            "delivery": row["delivery_status"],
+            "created_at": row["created_at"],
+            "site_message_id": int(row["site_message_id"]) if row.get("site_message_id") else None,
+        }
+
+    async def _topics(self, client_ids: set[int]) -> dict[str, str]:
+        topics = {}
+        for client_id in client_ids:
+            topic = await self.repo.get_topic(client_id)
+            if topic:
+                topics[str(client_id)] = render.topic_link(topic["manager_group_id"], topic["message_thread_id"])
+        return topics
+
+    # --- site -> bot ----------------------------------------------------
+
+    async def pull(self, http: aiohttp.ClientSession) -> bool:
+        after = int(await self.repo.get_setting(OUTGOING_CURSOR) or 0)
+        async with http.get(f"{self.url}/v1/internal/bot/outgoing", params={"after": after}) as response:
+            response.raise_for_status()
+            items = await response.json()
+        for item in items:
+            await self._take(item)
+        return len(items) == BATCH
+
+    async def _take(self, item: dict[str, Any]) -> None:
+        """Queue one reply or status change; the cursor moves in the same transaction, so it is taken once."""
+        async with self.repo.db.tx() as tx:
+            row = await tx.fetchone("SELECT value FROM settings WHERE key = ?", (OUTGOING_CURSOR,))
+            if row and int(row["value"]) >= item["id"]:
+                return
+            app = await tx.fetchone("SELECT id, client_id, status FROM applications WHERE id = ?", (item["app_id"],))
+            if app and item["kind"] == "message" and item.get("text"):
+                await self.repo._enqueue(tx, "site_reply", app["client_id"], {
+                    "app_id": app["id"], "text": item["text"][:4000], "sender_name": item.get("sender_name"),
+                    "site_message_id": item["message_id"],
+                })
+            elif app and item["kind"] == "status" and FROM_SITE.get(item.get("status")) not in (None, app["status"]):
+                await tx.execute("UPDATE applications SET status = ?, updated_at = ? WHERE id = ?",
+                                 (FROM_SITE[item["status"]], now_iso(), app["id"]))
+                await self.repo._enqueue(tx, "card_refresh", app["client_id"], {"app_id": app["id"]})
+            await tx.execute(
+                "INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+                (OUTGOING_CURSOR, str(item["id"])),
+            )
+        self.repo._wake()
