+++ b/tests/test_site_sync.py
@@ -0,0 +1,205 @@
+"""The website mirror: applications and conversations go to the site, replies and statuses come back."""
+
+import pytest
+
+from bot import site_sync
+from bot.site_sync import SiteSync
+from tests.harness import GROUP_ID, Harness, run
+
+CLIENT = 9
+
+
+class _Response:
+    def __init__(self, status: int, data=None):
+        self.status, self.data = status, data
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        return False
+
+    def raise_for_status(self):
+        if self.status >= 400:
+            raise RuntimeError(f"HTTP {self.status}")
+
+    async def json(self):
+        return self.data
+
+
+class FakeSite:
+    """Records what the bot sends; hands out replies and status changes written in the admin."""
+
+    def __init__(self):
+        self.pushed: list[dict] = []
+        self.outgoing: list[dict] = []
+        self.down = False
+        self.asked_after: list[int] = []
+
+    def post(self, url, json):
+        assert url.endswith("/v1/internal/bot/sync")
+        if self.down:
+            return _Response(503)
+        self.pushed.append(json)
+        return _Response(200, {"ok": True})
+
+    def get(self, url, params):
+        assert url.endswith("/v1/internal/bot/outgoing")
+        if self.down:
+            return _Response(503)
+        self.asked_after.append(params["after"])
+        return _Response(200, [item for item in self.outgoing if item["id"] > params["after"]])
+
+
+@pytest.fixture(autouse=True)
+def seconds_have_passed(monkeypatch):
+    """Rows of the current second wait for the next round; in these tests that second is long over."""
+    monkeypatch.setattr(site_sync, "now_iso", lambda delta=0: "2999-12-31T00:00:00")
+
+
+def test_a_change_within_the_current_second_waits_for_the_next_round(tmp_path, monkeypatch):
+    async def scenario(h: Harness):
+        site, s = FakeSite(), sync(h)
+        _, app_id = await client_with_application(h)
+        await h.db.execute("UPDATE applications SET updated_at = '2030-01-01T10:00:00' WHERE id = ?", (app_id,))
+        monkeypatch.setattr(site_sync, "now_iso", lambda delta=0: "2030-01-01T10:00:00")
+        await s.cycle(site)
+        assert not any(body["applications"] for body in site.pushed)
+        monkeypatch.setattr(site_sync, "now_iso", lambda delta=0: "2030-01-01T10:00:01")
+        await s.cycle(site)
+        assert [a["id"] for a in site.pushed[-1]["applications"]] == [app_id]
+
+    run(tmp_path, scenario, with_group=True)
+
+
+def sync(h: Harness) -> SiteSync:
+    return SiteSync(h.repo, "https://site.example/", "secret", "Europe/Madrid")
+
+
+async def client_with_application(h: Harness) -> tuple[object, int]:
+    client = h.user(CLIENT, "Ярослав", username="yarik")
+    await h.start_client(client)
+    app_id = await h.submit_code95(client)
+    await h.deliver()
+    return client, app_id
+
+
+def test_applications_and_messages_reach_the_site_once(tmp_path):
+    async def scenario(h: Harness):
+        site, s = FakeSite(), sync(h)
+        client, app_id = await client_with_application(h)
+        await h.say(client, "Коли можна почати?")
+        await h.deliver()
+
+        await s.cycle(site)
+        body = site.pushed[-1]
+        app = next(a for a in body["applications"] if a["id"] == app_id)
+        assert app["name"] == "Ярослав" and app["username"] == "yarik" and app["status"] == "new"
+        assert app["phone"].replace(" ", "").endswith("612345678")
+        assert "<" not in app["card"] and "Ярослав" in app["card"]
+        texts = [m["text"] for m in body["messages"] if m["direction"] == "client"]
+        assert "Коли можна почати?" in texts
+        assert all(m["app_id"] == app_id for m in body["messages"])
+        assert body["topics"][str(app["client_id"])].startswith("https://t.me/c/1234567890/")
+
+        before = len(site.pushed)
+        await s.cycle(site)
+        assert len(site.pushed) == before  # nothing new: nothing sent again
+
+        await h.repo.set_status(app_id, "done")
+        await h.db.execute("UPDATE applications SET updated_at = '2999-01-01T00:00:00' WHERE id = ?", (app_id,))
+        await s.cycle(site)
+        assert [a["status"] for a in site.pushed[-1]["applications"]] == ["done"]
